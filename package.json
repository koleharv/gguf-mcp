{
  "name": "gguf-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.arose26/gguf-mcp",
  "description": "MCP server that inspects local GGUF and safetensors model files — architecture, quantization, parameters, tensors, and VRAM-fit estimates from headers only, without loading the model",
  "type": "module",
  "bin": {
    "gguf-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "gguf",
    "safetensors",
    "llama.cpp",
    "llm",
    "local-llm",
    "vram",
    "quantization",
    "claude"
  ],
  "license": "MIT",
  "author": "Kole Harvey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arose26/gguf-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
